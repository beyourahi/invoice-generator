# Credentials for the drizzle-kit CLI — loaded by Bun for `bun run db:*` scripts.
# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Cloudflare account and D1 database — required for drizzle-kit's remote
# operations: db:push, db:pull, db:studio, db:check.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
